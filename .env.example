# .env.example

# Server — fixed local-development ports (do not change without updating
# docs/local-development.md, frontend/.env.example, and src/app.ts CORS).
# Backend always runs on 4000; frontend always runs on 3000.
PORT=4000
HOST=0.0.0.0
# Frontend origin(s) allowed by backend CORS (no wildcard; credentials preserved).
# Single origin: FRONTEND_ORIGIN=http://localhost:3000
# Multiple (comma-separated): FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
# Dev default (when unset, non-production): http://localhost:3000,http://localhost:3001,http://localhost:5173.
# In production only explicitly configured origins are allowed.
# FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
# PostgreSQL connection URL
# Example: postgres://user:password@localhost:5432/ai_voice_lead_qualification
DATABASE_URL=postgres://username:password@localhost:5432/your_database
# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lead_qualification
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# Vapi / outbound voice (Phase 14 — RETIRED)
# The legacy voice/Vapi system has been retired: text conversations are the
# primary AI interaction model. VAPI_API_KEY, VAPI_BASE_URL,
# VAPI_ASSISTANT_ID, VAPI_PHONE_NUMBER_ID, and VAPI_TIMEOUT_MS are no longer
# read by the backend. Historical `calls` rows remain in the database
# (read-only compatibility) but no voice routes exist. Do not set these.

# LLM (text conversations)
# Runtime providers: ollama (default when unset) or openai.
# `mock` is for automated tests only — never use it as the runtime provider.
# Ollama (local or remote/ngrok — set both values, no credentials in code):
LLM_PROVIDER=ollama
LLM_MODEL=your_ollama_model_tag
LLM_BASE_URL=http://127.0.0.1:11434
# Optional: request timeout in ms (default 90000 — local inference is slow).
# LLM_TIMEOUT_MS=90000
# Optional: sampling temperature 0-2 (default 0.2 for deterministic parsing).
# LLM_TEMPERATURE=0.2
# OpenAI alternative (Chat Completions):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your_llm_api_key
# LLM_BASE_URL=https://api.openai.com/v1

# CRM Integration (Phase 9 – provider-independent, async, failure-isolated)
CRM_SYNC_ENABLED=false
CRM_PROVIDER=http
CRM_API_KEY=your_crm_api_key
CRM_BASE_URL=https://api.yourcrm.com
CRM_CONTACT_UPSERT_PATH=/contacts/upsert
CRM_CONTACT_UPDATE_PATH=/contacts
CRM_TIMEOUT_MS=8000
CRM_MAX_RETRIES=3
CRM_RETRY_BASE_DELAY_MS=500

# Google Calendar / Meet (Phase 12 – explicit internal bookings only, disabled by default)
CALENDAR_ENABLED=false
CALENDAR_PROVIDER=google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_CALENDAR_ID=primary
CALENDAR_TIMEZONE=Asia/Kolkata
# Tiers eligible for booking (COLD never books in Phase 12).
CALENDAR_AUTO_BOOK_TIERS=HOT,WARM
CALENDAR_MIN_DURATION_MIN=15
CALENDAR_MAX_DURATION_MIN=120
CALENDAR_TIMEOUT_MS=8000
CALENDAR_MAX_RETRIES=3
CALENDAR_RETRY_BASE_DELAY_MS=500

# WhatsApp (Twilio provider – Phase 11, template sends only, disabled by default)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio
WHATSAPP_ACCOUNT_SID=your_twilio_sid
WHATSAPP_AUTH_TOKEN=your_twilio_auth_token
WHATSAPP_FROM_NUMBER=whatsapp:+1234567890
WHATSAPP_DEFAULT_LANGUAGE=en
# Deny-by-default: no consent source exists yet, so sends are skipped unless
# this is explicitly set to false (sandbox/test numbers only).
WHATSAPP_REQUIRE_CONSENT=true
# Vendor template/content SIDs per template_language (approved content vendor-side):
# WHATSAPP_TEMPLATES_JSON={"lead_welcome_en":"HX...","call_summary_hot_en":"HX..."}
WHATSAPP_TIMEOUT_MS=8000
WHATSAPP_MAX_RETRIES=3
WHATSAPP_RETRY_BASE_DELAY_MS=500

# n8n webhook secret
N8N_WEBHOOK_SECRET=your_n8n_secret
# n8n Workflow Automation (Phase 10 – async outbound only, disabled by default)
N8N_ENABLED=false
# Either a single webhook URL for all events:
N8N_WEBHOOK_URL=https://your-n8n.example/webhook/lead-events
# Or per-event fan-out as JSON (event -> [{ name, url }]):
# N8N_WORKFLOWS_JSON={"lead.created":[{"name":"lead-pipeline","url":"https://..."}],"call.completed":[{"name":"call-pipeline","url":"https://..."}]}
N8N_API_KEY=
N8N_TIMEOUT_MS=8000
N8N_MAX_RETRIES=3
N8N_RETRY_BASE_DELAY_MS=500
N8N_ALLOW_HTTP_LOCAL=false

# Embeddings & Vector Search (RAG)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=your_embedding_api_key

# Follow-up Automation (Phase 13 – scheduled rows only, no cron/workers, disabled by default)
FOLLOWUP_ENABLED=false
# Independently configurable delays (minutes): HOT WhatsApp, WARM WhatsApp, CRM (all tiers).
FOLLOWUP_HOT_DELAY_MIN=30
FOLLOWUP_WARM_DELAY_MIN=240
FOLLOWUP_CRM_DELAY_MIN=60
FOLLOWUP_MAX_ATTEMPTS=5
FOLLOWUP_MAX_RETRIES=3
FOLLOWUP_RETRY_BASE_DELAY_MS=500
FOLLOWUP_EXECUTE_LIMIT=25
FOLLOWUP_PROCESSING_TIMEOUT_MS=300000

# Text Conversations API (Phase 3 – JWT auth required, fail-closed when unset)
# Generate a long random secret for production; never commit real values.
CHAT_JWT_SECRET=
# Phase 11: legacy pasted-token fallback for conversation routes. Dev/test
# compatibility only — forced off in production regardless of this flag.
# CHAT_AUTH_FALLBACK_ENABLED=true
# Sliding-window rate limits for the conversation router only (Vapi untouched).
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=60
CHAT_MESSAGE_RATE_LIMIT_MAX=20
# Maximum user message length (characters).
CHAT_MAX_MESSAGE_LENGTH=4000
# Maximum persisted messages forwarded to the LLM per text turn (history
# window). Older rows stay in the database; only the LLM input is truncated.
CHAT_MAX_CONTEXT_MESSAGES=30
# Maximum LLM → tool → LLM rounds executed per text user message (Phase 5).
# Bounds the conversation-anchored tool loop; the legacy Vapi path is unaffected.
CHAT_MAX_TOOL_ROUNDS=3
# Allow legacy_voice creation through the text API (default false).
CHAT_ALLOW_LEGACY_VOICE=false
# First-party authentication (Phase 11 – server-only secrets, never VITE_*).
# Generate a long random secret for production; never commit real values.
AUTH_JWT_SECRET=
# Short-lived access token lifetime in seconds (default 900).
# AUTH_ACCESS_TTL_SEC=900
# Refresh token lifetime in seconds (default 604800 = 7 days).
# AUTH_REFRESH_TTL_SEC=604800
# Refresh cookie name (HttpOnly, SameSite=Lax, Secure in production).
# AUTH_REFRESH_COOKIE=mad_rt
# Login brute-force protection (attempts per window per IP).
# AUTH_LOGIN_MAX_ATTEMPTS=10
# AUTH_LOGIN_WINDOW_MS=600000

