# MadVoice AI — Frontend environment configuration (Phase 14C-3)
#
# Copy to `.env` for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Only PUBLIC configuration may use the VITE_ prefix. VITE_* variables are
#   embedded into the browser bundle and visible to anyone.
# - NEVER put API keys, CRM secrets, Vapi secrets, Google credentials, or
#   WhatsApp credentials in VITE_ variables or frontend code.

# Base URL of the existing Express backend (no trailing slash).
# Fixed local backend: http://localhost:4000 (backend PORT=4000).
VITE_API_BASE_URL=http://localhost:4000

# Mock/real data switch.
# true  (default) -> lists stay on mock data; detail/edit/create/search pages
#                    attempt the real API first and fall back to demo records
#                    when the backend has no matching entry.
# false -> same behavior today; per-page mock removal happens in future phases.
# The flag is read by `client/src/api/env.ts` (isMockDataEnabled()).
VITE_USE_MOCK_DATA=true

# Pre-existing platform/hosting variables (not managed here):
# VITE_OAUTH_PORTAL_URL / VITE_APP_ID (Manus preview login),
# VITE_FRONTEND_FORGE_API_KEY / VITE_FRONTEND_FORGE_API_URL (map proxy).
# OAUTH_SERVER_URL (server-side, Manus preview login only) is NOT required for
# local development. Local auth uses the Express backend above (first-party
# JWT + HttpOnly refresh cookie). Do not invent an OAuth server locally.
