# MadLead AI — Frontend environment configuration
#
# Copy to `.env` for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Only PUBLIC configuration may use the VITE_ prefix. VITE_* variables are
#   embedded into the browser bundle and visible to anyone.
# - NEVER put API keys, CRM secrets, Google credentials, or WhatsApp
#   credentials in VITE_ variables or frontend code.
#
# Base URL of the Express backend (no trailing slash). Required: without it
# every backend-backed page renders its error state with retry.
# Local backend: VITE_API_BASE_URL=http://localhost:4000
# Deployed (separate hosts): VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=http://localhost:4000

# Pre-existing platform/hosting variables (not managed here):
# VITE_OAUTH_PORTAL_URL / VITE_APP_ID (preview login),
# VITE_FRONTEND_FORGE_API_KEY / VITE_FRONTEND_FORGE_API_URL (map proxy).
# OAUTH_SERVER_URL (server-side, preview login only) is NOT required for
# local development. Local auth uses the Express backend above (first-party
# JWT + HttpOnly refresh cookie). Do not invent an OAuth server locally.
